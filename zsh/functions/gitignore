# Query gitignore.io API for templates
# Usage: gitignore <template1> [template2...]

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: gitignore <template> [additional templates...]"
    echo "Example: gitignore python node visualstudiocode"
    return 0
fi

local IFS=","
curl -sL "https://www.toptal.com/developers/gitignore/api/$*"
