# Function to query wttr.in for weather
# Usage: weather [city_name] [format_string]

_weather_help() {
  cat <<'EOF'
weather [CITY_NAME] [FORMAT_STRING]

Description:
  Queries wttr.in to get current weather information for a specified city
  or automatically detects your current location if no city is provided.

Arguments:
  CITY_NAME      (Optional) City name (e.g., "Kuala Lumpur", "New York").
  FORMAT_STRING  (Optional) Format string for wttr.in (e.g. "1Fm", "4", "%t").

Examples:
  weather                     # Default weather
  weather "Kuala Lumpur"      # Weather for Kuala Lumpur
  weather London 4            # One-line weather for London
  weather --help              # Display this help message
EOF
}

_weather_url_encode() {
  local string="$1"
  local encoded=""
  local c

  for c in ${(s::)string}; do
    if [[ "$c" =~ [a-zA-Z0-9.~_-] ]]; then
      encoded+="$c"
    else
      encoded+=$(printf '%%%02X' "'$c")
    fi
  done

  echo "$encoded"
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    _weather_help
    return 0
fi

local city="${1:-Kuantan}"
local format="${2:-1Fm}"

local encoded_city="$(_weather_url_encode "$city")"
local encoded_format="$(_weather_url_encode "$format")"

curl -s "wttr.in/${encoded_city}?${encoded_format}"
