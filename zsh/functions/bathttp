# Function: bathttp (Highlight as HTTP using bat)
# Highlights a given string or piped input as HTML using 'bat'.
bathttp() {
  if [[ "$1" = "--help" || "$1" = "-h" ]]; then
    _bathttp_help
    return 0
  fi

  # Check if input is coming from a pipe (stdin is not a terminal)
  if ! [ -t 0 ]; then
    # Input is piped, read from stdin
    cat - | bat -l http
  elif [ -n "$@" ]; then
    # Input is from arguments, join them and pipe to bat
    echo "$@" | bat -l http
  else
    echo "Usage: bathtml <string_to_highlight>"
    echo "       or cat <file> | bat -l http"
    _bathttp_help # Show full help if no input
    return 1
  fi
}

# Help text for bathtml
_bathttp_help() {
  cat <<EOF
bathttp [STRING_TO_HIGHLIGHT]

Description:
  Highlights a given string or piped input as HTTP using the 'bat' utility.
  Useful for quickly viewing HTML snippets or files with syntax highlighting.

Arguments:
  STRING_TO_HIGHLIGHT  (Optional) The HTTP string to highlight.
                       If omitted, the function expects input from a pipe.

Examples:
  bathttp '<h1>Hello World!</h1><p>This is HTML.</p>'
  cat index.html | bathtml
  echo '<div class="container"><span>Test</span></div>' | bathttp
  bathttp --help               # Display this help message
EOF
}
