# Display a progress bar instead of the default meter
progress-bar

# Show detailed error messages when a transfer fails
show-error

# Follow HTTP redirects automatically
location

# Increase the maximum time allowed for the transfer (seconds)
connect-timeout = 30
max-time = 300

# Set a custom User-Agent for better compatibility with some sites
user-agent = "Mozilla/5.0 (X11; Linux x86_64) cURL/8.0"

# --- WSL2 Specific & Proxy Settings ---
# Use this if you are behind a corporate or Windows-side proxy (uncomment to use)
# proxy = "http://127.0.0.1:8888"

# If using a proxy with authentication:
# proxy-user = "username:password"

# --- Output Formatting ---
# Always write the output to a file named after the remote file
# remote-name

# Enable compressed transfers (gzip, etc.)
compressed
